# Required: OpenAI Chat Completions compatible endpoint base URL.
# Example: https://example.com/v1
CX2CC_UPSTREAM_BASE_URL=

# Optional fallback API key(s). Claude Code / CC Switch can also pass the upstream
# key through the x-api-key header. Multiple fallback keys may be separated by
# commas or newlines.
CX2CC_UPSTREAM_API_KEY=
# CX2CC_UPSTREAM_API_KEYS=key1,key2

# Optional: model name requested from the upstream (default: gpt-5.5).
# CX2CC_UPSTREAM_MODEL=

# Optional: report the model the upstream actually served instead of echoing the
# client's requested model name. Accepts 1/true/yes/on.
# CX2CC_REPORT_UPSTREAM_MODEL=

# A per-conversation prompt_cache_key is sent by default so OpenAI-style
# upstreams keep each conversation on one cache node. Set to "off" only if your
# upstream rejects unknown request fields.
# CX2CC_PROMPT_CACHE_KEY=off

# Local listener. Keep 127.0.0.1 unless you understand the security impact of
# exposing the proxy to other machines.
CX2CC_HOST=127.0.0.1
CX2CC_PORT=8901
