# Where cx2cc listens, as seen from inside the container.
CX2CC_GW_UPSTREAM=http://172.17.0.1:18901
# The one key cx2cc (and codex-bridge) accepts. Clients never see it.
CX2CC_GW_UPSTREAM_TOKEN=change-me
# Path prefix the reverse proxy keeps in front of API calls (https://host/api/v1/messages).
CX2CC_GW_API_PREFIX=/api
# Session cookie only over HTTPS. Set 0 only for plain-HTTP local testing.
CX2CC_GW_COOKIE_SECURE=1
# Take the client IP from X-Real-IP / X-Forwarded-For set by the reverse proxy.
CX2CC_GW_TRUST_PROXY=1
# Console session lifetime in hours.
CX2CC_GW_SESSION_HOURS=12
# Upstream silence tolerated inside one response (long reasoning turns), seconds.
CX2CC_GW_UPSTREAM_READ_TIMEOUT=900
